{# templates/emails/demande_importation.html.twig #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { margin: 0; padding: 0; background-color: #f4f7f9; font-family: 'Segoe UI', Helvetica, Arial, sans-serif; }
        .wrapper { width: 100%; table-layout: fixed; background-color: #f4f7f9; padding: 20px 0; }
        .container { max-width: 650px; margin: 0 auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; border: 1px solid #e1e4e8; }

        /* Header Raftras */
        .header { background-color: #2c437b; padding: 25px; text-align: center; }
        .header h1 { color: #ffffff; margin: 0; font-size: 24px; text-transform: uppercase; letter-spacing: 1px; }

        .content { padding: 35px; color: #333333; }
        .title { color: #2c437b; font-size: 20px; font-weight: bold; margin-bottom: 25px; border-bottom: 2px solid #2c437b; display: inline-block; padding-bottom: 5px; }

        /* Table de données pour plus de clarté */
        .data-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        .data-table td { padding: 12px 10px; border-bottom: 1px solid #f0f0f0; vertical-align: top; }
        .label { color: #2c437b; font-weight: bold; width: 180px; font-size: 13px; text-transform: uppercase; }
        .value { color: #444444; font-size: 15px; }

        .description-box { background-color: #f9fbfc; border: 1px solid #e8edf2; padding: 15px; border-radius: 6px; margin-top: 10px; line-height: 1.6; }

        /* Footer */
        .footer { background-color: #f8f9fa; padding: 25px; text-align: center; color: #666666; font-size: 12px; border-top: 1px solid #eeeeee; }
        .contact-info { margin-bottom: 5px; color: #2c437b; font-weight: bold; }
    </style>
</head>
<body>
<center class="wrapper">
    <div class="container">
        <div class="header">
            <h1>Raftras</h1>
        </div>

        <div class="content">
            <div class="title">Nouvelle Demande d'Importation</div>

            <table class="data-table">
                <tr>
                    <td class="label">Entreprise</td>
                    <td class="value"><strong>{{ nom_entreprise|upper }}</strong></td>
                </tr>
                <tr>
                    <td class="label">Contact Direct</td>
                    <td class="value">{{ email }} <br> {{ telephone }}</td>
                </tr>
                <tr>
                    <td class="label">Localisation</td>
                    <td class="value">{{ localisation_entreprise }}</td>
                </tr>
                <tr>
                    <td class="label">Flux Logistique</td>
                    <td class="value">
                        De : <strong>{{ pays_importation }}</strong> <br>
                        Vers : <strong>{{ pays_destination }}</strong>
                    </td>
                </tr>
            </table>

            <div style="margin-top: 25px;">
                <span class="label">Description de la Commande</span>
                <div class="description-box">
                    {{ description_commande|nl2br }}
                </div>
            </div>
        </div>

        <div class="footer">
            <div class="contact-info">RAFTRAS SARL</div>
            Hamdallaye ACI, Bamako, Mali<br>
            Tél : +223 70 70 70 70<br>
            <div style="margin-top: 15px; font-style: italic; opacity: 0.7;">
                Document généré via le portail import Raftras.
            </div>
        </div>
    </div>
</center>
</body>
</html>