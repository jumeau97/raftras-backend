{# templates/emails/contact_raftras.html.twig #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        /* Styles de base pour assurer la compatibilité */
        body { margin: 0; padding: 0; background-color: #f1f3f6; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; }
        .wrapper { width: 100%; table-layout: fixed; background-color: #f1f3f6; padding-top: 30px; padding-bottom: 30px; }
        .container { max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }

        /* En-tête avec votre couleur #2c437b */
        .header { background-color: #2c437b; padding: 30px; text-align: center; }
        .header h1 { color: #ffffff; margin: 0; font-size: 28px; letter-spacing: 2px; text-transform: uppercase; }

        /* Contenu du message */
        .content { padding: 40px; color: #444444; }
        .intro { font-size: 18px; color: #2c437b; font-weight: bold; border-bottom: 2px solid #f1f3f6; padding-bottom: 10px; margin-bottom: 25px; }

        .info-group { margin-bottom: 20px; }
        .label { color: #888888; font-size: 12px; text-transform: uppercase; font-weight: bold; display: block; margin-bottom: 5px; }
        .value { color: #333333; font-size: 16px; background: #f8f9fb; padding: 12px; border-radius: 6px; }

        /* Footer avec vos infos spécifiques */
        .footer { background-color: #2c437b; padding: 25px; text-align: center; color: #ffffff; font-size: 13px; line-height: 1.6; }
        .footer a { color: #ffffff; text-decoration: none; }
        .divider { margin: 10px 0; border-top: 1px solid rgba(255,255,255,0.2); }
    </style>
</head>
<body>
<center class="wrapper">
    <div class="container">
        <div class="header">
            <h1>Raftras</h1>
        </div>

        <div class="content">
            <div class="intro">Nouveau message reçu</div>

            <div class="info-group">
                <span class="label">Expéditeur</span>
                <div class="value"><strong>{{ nom|upper }} {{ prenom|capitalize }}</strong></div>
            </div>

            <div class="info-group">
                <span class="label">Objet</span>
                <div class="value">{{ sujet }}</div>
            </div>

            <div class="info-group">
                <span class="label">Message</span>
                <div style="background: #f8f9fb; padding: 15px; border-radius: 6px; color: #444; line-height: 1.8;">
                    {{ message|nl2br }}
                </div>
            </div>
        </div>

        <div class="footer">
            <strong>Raftras</strong><br>
            Hamdallaye ACI, Bamako, Mali<br>
            Tél : +223 70 70 70 70
            <div class="divider"></div>
            <div style="font-size: 11px; opacity: 0.8;">
                Ceci est un email automatique envoyé depuis votre formulaire de contact.
            </div>
        </div>
    </div>
</center>
</body>
</html>